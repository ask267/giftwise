# Copy to .env (in this folder, or one folder above) and fill in.
# Course key: works with gpt-6-luna only.
PORTKEY_API_KEY=

# Optional: daily AI spending cap (new AI runs pause once either is reached)
# GIFT_DAILY_BUDGET_USD=0.50
# GIFT_DAILY_REQUEST_LIMIT=400

# Optional: automatic reminder emails (the app works without these)
# GIFT_SMTP_HOST=smtp.gmail.com
# GIFT_SMTP_PORT=587
# GIFT_SMTP_USER=you@gmail.com
# GIFT_SMTP_PASSWORD=your-app-password
# GIFT_SMTP_FROM=you@gmail.com
